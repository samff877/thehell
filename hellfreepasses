local function onChatted(msg, speaker)
    if admins[speaker.UserId] then
        local lowerMsg = msg:lower()
       
        if lowerMsg:sub(1, 6) == "!spam " then
            local target = msg:sub(7)
            if target ~= "" then
                enabled = false
                task.wait(0.1)
                startSpamming(target, delayBox.Text, lineBox.Text)
                notify("ADMIN COMMAND", "Spam started on: " .. target)
                startBtn.Text = "RUNNING"
            end
        elseif lowerMsg == "!stop" then
            enabled = false
            notify("ADMIN COMMAND", "Spam stopped by Admin")
            startBtn.Text = "START"
        end
    end
end

TextChatService.MessageReceived:Connect(function(textResult)
    local speaker = Players:GetPlayerByUserId(textResult.TextSource.UserId)
