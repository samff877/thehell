local function send(msg)
    local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
    if channel then
        channel:SendAsync(msg)
    end
end

local function startSpamming(targetName, delayVal, styleChar)
    if enabled then return end
   
    local delayTime = tonumber(delayVal) or 2
    local style = (styleChar ~= "" and styleChar) or "_"
    local line = string.rep(style, 160)
   
    enabled = true
    task.spawn(function()
        while enabled do
            for _, msg in ipairs(replies) do
                if not enabled then break end
                send(line .. " " .. targetName .. " " .. msg)
                task.wait(delayTime)
            end
            task.wait()
        end
    end)
end

